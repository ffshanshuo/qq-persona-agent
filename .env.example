# 本文件示例的是「代码真正会读的环境变量」（scripts/ 与 lib/ 里 grep process.env 得到）。
# 在 Windows 上请用 `set VAR=value`（cmd）或 `$env:VAR="value"`（PowerShell）；
# Linux/macOS 直接 `export VAR=value`。

# ============ OneBot / NapCat ============
# NapCat 的 OneBot v11 HTTP 基址（默认 3000）
OB11_BASE=http://127.0.0.1:3000
# HTTP 调用的 access token（必填，自己在 NapCat 配置里设一个强随机值）
OB11_TOKEN=
# 单次调用超时（毫秒）。别关：没有超时会让「正在输入」永久挂着并堵死发送队列
OB11_TIMEOUT_MS=5000

# ============ 模型出口 ============
# brain.js / vision.js 的实际参数在 config/brain.json、config/…里；
# 想用另一套配置（比如换个网关）就指向另一个 json 文件。
# BRAIN_CONFIG=config/brain.json
# 视觉（表情打标/看图）的出口，默认同 brain 的 baseUrl
# VISION_ENDPOINT=http://127.0.0.1:8326/v1/chat/completions
# 放 API key 的文件路径（一行纯 key，chmod 600，绝不入库）
# VISION_TOKEN_FILE=scripts/gw.token

# ============ 演练（强烈建议先跑一天） ============
# 1 = 只决策、只拼消息段，不真正发送
AUTOREPLY_DRY=1
# 保留 TTS 临时 wav（排查语音问题）
AUTOREPLY_KEEP_WAV=

# ============ 我的 QQ 号（少数脚本会读） ============
# SELF_UIN=123456789

# ============ 调试：把各层状态/日志指到别处 ============
# 各层都支持 QQ*_DIR 隔离（测试脚本就是这么避免污染生产状态的）
# QQCTX_DIR=logs/context-dev
# QQMIND_DIR=logs/mind-dev
# QQTRACE_DIR=logs/trace-dev
# QQECHO_DIR=logs/echo-dev
# QQBOND_DIR=logs/bonds-dev
# QQPROMISE_DIR=logs/promises-dev
# QQLONGING_DIR=logs/longing-dev
# QQTHEM_DIR=logs/them-dev
# QQRISK_DIR=logs/risk-dev
# QQPACING_DIR=logs/pacing-dev
# QQSELF_DIR=logs/self-dev
# QQGROUP_DIR=logs/group-dev
# QQEVOLVE_DIR=logs/evolve-dev
# QQTUNING_FILE=config/tuning.json
# AUTOREPLY_LOG=logs/autoreply.log
# AUTOREPLY_STATE=logs/autoreply-state.json

# ============ 表情 ============
# 表情库目录（默认 assets/stickers）
# STICKER_DIR=assets/stickers
# 额外禁用名单（前缀，逗号分隔）；默认已禁自绘月亮脸 dsh-
# QQSTICKER_BAN=dsh-
# 关闭上网抓表情 / 只演练不落盘
# STICKER_FETCH_DISABLED=1
# STICKER_FETCH_DRY=1
# 转 gif→拼图 PNG 用的 Python（本项目其余部分不需要 Python）
# STICKER_PYTHON=python

# ============ A 通道（adb 操作手机官方 QQ，备用） ============
# ADB_PATH=adb
# ANDROID_SERIAL=
# QQ_PKG=com.tencent.mobileqq
